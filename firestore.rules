rules_version = '2';

// Asthetic — Kvízcsata jogosultsági szabályok
//
// Alapelv: a szobát CSAK a szobavezető írhatja, a játékos kizárólag a saját
// jelentkezését és a saját válaszát. A helyes választ és a videó azonosítóját
// külön dokumentum tárolja, amit rajta kívül senki nem olvashat — így a kérdés
// alatt a böngésző konzoljából sem szedhető ki.

service cloud.firestore {
  match /databases/{database}/documents {

    function bejelentkezett() {
      return request.auth != null;
    }

    function szobavezetoE(kod) {
      return bejelentkezett()
        && exists(/databases/$(database)/documents/szobak/$(kod))
        && get(/databases/$(database)/documents/szobak/$(kod)).data.hostUid == request.auth.uid;
    }

    match /szobak/{kod} {
      // A szobák állapotát bárki olvashatja, aki be van jelentkezve: ebből áll
      // össze a nyilvános szobalista, és ezt látják a játékosok a játék alatt.
      // Titkot nem tartalmaz.
      allow get, list: if bejelentkezett();

      // Szobát csak saját magának nyithat valaki.
      allow create: if bejelentkezett()
        && request.resource.data.hostUid == request.auth.uid;

      // A játék menetét kizárólag a szobavezető írhatja.
      allow update, delete: if bejelentkezett()
        && resource.data.hostUid == request.auth.uid;

      // Videó azonosítója + helyes válasz — csak a szobavezetőnek.
      match /titkos/{doc} {
        allow read, write: if szobavezetoE(kod);
      }

      // Jelentkezés belépésre: mindenki csak a sajátját hozhatja létre.
      match /jelentkezok/{jelentkezoUid} {
        allow create: if bejelentkezett() && jelentkezoUid == request.auth.uid;
        allow read, delete: if szobavezetoE(kod)
          || (bejelentkezett() && jelentkezoUid == request.auth.uid);
      }

      // Válaszok: a dokumentum azonosítója maga a felhasználó azonosítója,
      // így egyetlen összehasonlítással eldönthető, hogy a sajátját írja-e.
      // Más válaszát senki nem láthatja — csak a szobavezető, a kiértékeléshez.
      match /valaszok/{valaszUid} {
        allow read, write: if bejelentkezett() && valaszUid == request.auth.uid;
        allow read, delete: if szobavezetoE(kod);
      }
    }

    // ───────────── Rubik-Bingó ─────────────
    // Zárt teszt: csak a felsorolt Google-fiókok érik el. Ugyanez a lista van a
    // js/fiok.js-ben is — a kettőnek egyeznie kell.

    function tesztelo() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['kisskorboy1990@gmail.com', 'richardszenti@gmail.com'];
    }

    function bingoVezetoE(kod) {
      return tesztelo()
        && exists(/databases/$(database)/documents/bingo/$(kod))
        && get(/databases/$(database)/documents/bingo/$(kod)).data.hostUid == request.auth.uid;
    }

    match /bingo/{kod} {
      allow get, list: if tesztelo();
      allow create: if tesztelo() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if tesztelo() && resource.data.hostUid == request.auth.uid;

      // A dal adatai kör közben — csak a szobavezetőnek.
      match /titkos/{doc} {
        allow read, write: if bingoVezetoE(kod);
      }

      match /jelentkezok/{jelentkezoUid} {
        allow create: if tesztelo() && jelentkezoUid == request.auth.uid;
        allow read, delete: if bingoVezetoE(kod)
          || (tesztelo() && jelentkezoUid == request.auth.uid);
      }

      // Tipp, lecsapás, ikszelés: mindenki csak a sajátját írja, és a tippjét
      // rajta kívül csak a szobavezető látja.
      match /lepesek/{jatekosUid} {
        allow read, write: if tesztelo() && jatekosUid == request.auth.uid;
        allow read, delete: if bingoVezetoE(kod);
      }
    }
  }
}
